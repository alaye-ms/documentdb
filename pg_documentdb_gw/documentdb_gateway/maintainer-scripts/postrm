#!/bin/bash
set -e

case "$1" in
    purge)
        rm -f /etc/documentdb/documentdb-postgresql.env
        rmdir --ignore-fail-on-non-empty /etc/documentdb 2>/dev/null || true
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;
    remove|disappear|upgrade)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;
esac

exit 0
