#!/bin/bash
set -e

case "$1" in
    configure)
        if ! getent group documentdb >/dev/null 2>&1; then
            groupadd --system documentdb
        fi

        if ! id -u documentdb >/dev/null 2>&1; then
            useradd --system --no-create-home --home-dir /var/lib/documentdb --shell /usr/sbin/nologin --gid documentdb documentdb
        fi

        mkdir -p /var/lib/documentdb
        chown documentdb:documentdb /var/lib/documentdb

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi

        echo "DocumentDB Gateway runtime installed."
        echo "Choose the PostgreSQL major you want and install the matching DocumentDB extension package before running documentdb-setup."
        echo "For example: sudo apt install postgresql-17-documentdb"
        echo "Next step:"
        echo "  sudo documentdb-setup --username <USER> --password-file <FILE>"
        ;;
esac

exit 0
