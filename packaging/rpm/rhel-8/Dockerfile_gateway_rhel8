ARG BASE_IMAGE=rockylinux:8
FROM ${BASE_IMAGE}

ARG DOCUMENTDB_VERSION

ENV DOCUMENTDB_VERSION=${DOCUMENTDB_VERSION}
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo
ENV PATH="/root/.cargo/bin:${PATH}"

RUN test -n "$DOCUMENTDB_VERSION" || (echo "DOCUMENTDB_VERSION not set" && false)

RUN dnf -y swap curl-minimal curl && \
    dnf -y install \
        ca-certificates \
        cmake \
        curl \
        findutils \
        gcc \
        gcc-c++ \
        git \
        make \
        openssl-devel \
        pkgconf-pkg-config \
        rpm-build \
        tar && \
    dnf clean all

WORKDIR /build
COPY . /build

RUN /build/scripts/install_rustup.sh --install-toolchain

WORKDIR /build/pg_documentdb_gw
RUN CARGO_MANIFEST_DIR=/build/pg_documentdb_gw cargo build --profile=release-with-symbols -p documentdb_gateway

RUN mkdir -p /root/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS} && \
    cp /build/pg_documentdb_gw/target/release-with-symbols/documentdb_gateway /root/rpmbuild/SOURCES/ && \
    cp /build/documentdb-local/scripts/documentdb-setup.sh /root/rpmbuild/SOURCES/ && \
    cp /build/pg_documentdb_gw/SetupConfiguration.json /root/rpmbuild/SOURCES/ && \
    cp /build/packaging/gateway/systemd/documentdb-postgresql.service /root/rpmbuild/SOURCES/ && \
    cp /build/packaging/gateway/systemd/documentdb-gateway.service /root/rpmbuild/SOURCES/ && \
    mkdir -p /root/rpmbuild/SOURCES/scripts /root/rpmbuild/SOURCES/sample-data && \
    for script in utils.sh start_oss_server.sh build_and_start_gateway.sh setup_psqlrc.sh; do \
        cp "/build/scripts/${script}" /root/rpmbuild/SOURCES/scripts/; \
    done && \
    for script in documentdb_postgresql_service.sh emulator_entrypoint.sh init_documentdb_data.sh; do \
        cp "/build/documentdb-local/scripts/${script}" /root/rpmbuild/SOURCES/scripts/; \
    done && \
    for data_file in 01-users.js 02-products.js 03-orders.js 04-analytics.js README.md; do \
        cp "/build/documentdb-local/sample-data/${data_file}" /root/rpmbuild/SOURCES/sample-data/; \
    done && \
    cp /build/packaging/rpm/spec/documentdb_gateway.spec /root/rpmbuild/SPECS/ && \
    sed -i "s/DOCUMENTDB_VERSION/${DOCUMENTDB_VERSION}/g" /root/rpmbuild/SPECS/documentdb_gateway.spec

CMD ["/bin/bash", "-lc", "set -euo pipefail && rpmbuild -bb /root/rpmbuild/SPECS/documentdb_gateway.spec --define '_topdir /root/rpmbuild' && find /root/rpmbuild/RPMS -type f -name 'documentdb_gateway-*.rpm' -exec cp {} /output/ \\; && chown -R \"$(stat -c '%u:%g' /output)\" /output"]
